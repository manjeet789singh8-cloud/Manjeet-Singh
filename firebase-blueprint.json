{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered guest or user profile for TFC Garden",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "description": "Phone or mobile number"
        },
        "role": {
          "type": "string",
          "description": "User role: guest or admin"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records indexed by auth UID"
    },
    "/test/{docId}": {
      "schema": "UserProfile",
      "description": "Test connectivity collection"
    }
  }
}
